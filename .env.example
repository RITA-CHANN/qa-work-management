# Copy to .env (cp .env.example .env) and adjust if a port is taken.

# ---- API ----
NODE_ENV=development
API_PORT=3000
# The web dev server proxies /api to API_PORT, so browser and API share one origin.
WEB_PORT=5173
LOG_LEVEL=info

# ---- Database ----
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qawm_dev
# Used by Playwright runs so tests never touch your dev data.
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/qawm_test

# ---- Auth (Phase 2) ----
SESSION_TTL_HOURS=168
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MIN=15

# ---- AI (Phase 8+) ----
AI_PROVIDER=mock
