// QA Work Management database schema.
// See docs/database/README.md (one file per table in docs/database/tables/); tables are added phase by phase.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum GlobalRole {
  ADMIN
  USER
}

/// BR-ADMIN-10: a deactivated account can't sign in; it is never deleted.
enum UserStatus {
  ACTIVE
  DEACTIVATED
}

/// A person who can sign in. See docs/database/tables/users.md.
model User {
  id                 String          @id @default(cuid())
  /// Always stored lower-case (BR-AUTH-01).
  email              String          @unique
  name               String
  globalRole         GlobalRole      @default(USER) @map("global_role")
  /// argon2id hash; null means the user can't log in (BR-AUTH-12).
  passwordHash       String?         @map("password_hash")
  status             UserStatus      @default(ACTIVE)
  /// Set when an Admin creates the account or resets its password (BR-ADMIN-07, BR-ADMIN-12).
  mustChangePassword Boolean         @default(false) @map("must_change_password")
  lastSignInAt       DateTime?       @map("last_sign_in_at")
  /// The project the shell opens on (BR-SHELL-04).
  lastProjectId      String?         @map("last_project_id")
  lastProject        Project?        @relation("UserLastProject", fields: [lastProjectId], references: [id], onDelete: SetNull)
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")
  sessions           Session[]
  memberships        ProjectMember[]
  projectsCreated    Project[]       @relation("ProjectCreatedBy")
  activities         ActivityLog[]
  auditEvents        AuditEvent[]

  @@map("users")
}

/// One logged-in browser. See docs/database/tables/sessions.md.
model Session {
  /// SHA-256 (hex) of the token in the qawm_sid cookie. The token itself is never stored.
  idHash    String   @id @map("id_hash")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("sessions")
}

/// The 8 project roles. Permissions per role: docs/requirements/project/README.md#permission-matrix.
enum ProjectRole {
  OWNER
  PROJECT_MANAGER
  QA_LEAD
  QA_ENGINEER
  TEAM_LEAD
  DEVELOPER
  STAKEHOLDER
  VIEWER
}

enum ReleaseStatus {
  PLANNED
  ACTIVE
  RELEASED
}

enum MilestoneStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

/// A project. See docs/database/tables/projects.md.
model Project {
  id           String          @id @default(cuid())
  /// Upper-case, never changes (BR-PROJECT-02, BR-PROJECT-03). Check constraint in the migration.
  key          String          @unique
  name         String
  description  String?
  /// null means active (BR-PROJECT-08).
  archivedAt   DateTime?       @map("archived_at")
  /// Optimistic locking (DD-PROJECT-03).
  version      Int             @default(1)
  createdById  String          @map("created_by_id")
  createdBy    User            @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  members      ProjectMember[]
  releases     Release[]
  milestones   Milestone[]
  activities   ActivityLog[]
  lastOpenedBy User[]          @relation("UserLastProject")

  @@map("projects")
}

/// A person's role in a project. See docs/database/tables/project_members.md.
model ProjectMember {
  projectId String      @map("project_id")
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String      @map("user_id")
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ProjectRole
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

/// A release of a project. See docs/database/tables/releases.md.
/// One ACTIVE release per project: partial unique index in the migration (BR-PROJECT-17).
model Release {
  id             String        @id @default(cuid())
  projectId      String        @map("project_id")
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  name           String
  /// lower(trim(name)), for uniqueness (BR-PROJECT-14).
  nameNormalized String        @map("name_normalized")
  status         ReleaseStatus @default(PLANNED)
  startDate      DateTime?     @map("start_date") @db.Date
  targetDate     DateTime?     @map("target_date") @db.Date
  version        Int           @default(1)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  milestones     Milestone[]

  @@unique([projectId, nameNormalized])
  @@map("releases")
}

/// A milestone (sprint) inside a release. See docs/database/tables/milestones.md.
/// One ACTIVE milestone per project: partial unique index in the migration (BR-PROJECT-32).
model Milestone {
  id             String          @id @default(cuid())
  projectId      String          @map("project_id")
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  releaseId      String          @map("release_id")
  release        Release         @relation(fields: [releaseId], references: [id], onDelete: Restrict)
  name           String
  nameNormalized String          @map("name_normalized")
  goal           String?
  startDate      DateTime        @map("start_date") @db.Date
  endDate        DateTime        @map("end_date") @db.Date
  status         MilestoneStatus @default(PLANNED)
  version        Int             @default(1)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@unique([projectId, nameNormalized])
  @@index([releaseId])
  @@map("milestones")
}

/// One change in a project, written in the same transaction as the change (BR-PROJECT-22).
/// See docs/database/tables/activity_logs.md.
model ActivityLog {
  id         String   @id @default(cuid())
  projectId  String   @map("project_id")
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorId    String   @map("actor_id")
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  /// `<entity>.<verb>`, e.g. member.role_changed (DD-PROJECT-02).
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  /// Sentence frozen at write time (BR-PROJECT-20).
  summary    String
  changes    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([projectId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("activity_logs")
}

/// Security and admin events, workspace-wide (BR-ADMIN-14..17). Never updated or deleted by the app.
/// See docs/database/tables/audit_events.md.
model AuditEvent {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now()) @map("created_at")
  /// null for a failed sign-in with an unknown email.
  actorId    String?  @map("actor_id")
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  /// `<area>.<verb>`, e.g. auth.sign_in_failed, user.role_changed, project.updated.
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  /// Readable name of the target, frozen at write time (an email, a project key).
  targetName String   @map("target_name")
  /// Project key, when the event is about a project.
  projectKey String?  @map("project_key")
  before     Json?
  after      Json?
  /// ADMIN when an Admin acted on a project they are not a member of (BR-ADMIN-14).
  actedAs    String?  @map("acted_as")
  ip         String?

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([actorId])
  @@index([action])
  @@map("audit_events")
}
